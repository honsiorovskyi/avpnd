{
  "manifest_version": 3,
  "name": "avpnd",
  "version": "__VERSION__",
  "description": "Controls the avpnd AWS VPN Client wrapper daemon",
  "author": "honsiorovskyi",
  "icons": {
    "64": "icons/64.png",
    "48": "icons/48.png",
    "32": "icons/32.png"
  },
  "action": {
    "default_icon": {
      "19": "icons/19.png",
      "38": "icons/38.png"
    },
    "default_title": "avpnd"
  },
  "background": {
    "service_worker": "src/background-script.js"
  },
  "permissions": [
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:35002/*"
  ]
}
